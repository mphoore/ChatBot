<Window x:Class="demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo"
        mc:Ignorable="d"
        Title="CYBERGUARD AI CHATBOT" Height="450" Width="800">
    <Grid>

        <!-- 
            HOME GRID
            This grid serves as the main landing page  of the application.
            It contains a logo for AI , a welcome message to greet users,
            and a navigation button to proceed to the next section.
            Currently hidden by default.
        -->
        <Grid x:Name="home_grid" Visibility="Visible"
              Background="LightBlue"
              >
            
            <!-- Logo -->
            <Image 
                Source="/logo.jpg" 
                Height="200"
                Width="300"
                Margin="0,0,0,200"
                   />
<!-- welcome message-->
            <TextBlock
                Text="Greetings Welcome to CyberGuard AI ChatBot, Click next to continue"
                Height="30"
                Width="500"
                TextAlignment="Center"
                Margin="0,40,0,0"
                FontFamily="Calibri"
                FontSize="16"
                Foreground="Navy"
                />
            
            <!-- button to continue-->
            <Button 
                Height="40"
                Width="150"
                Margin="0,200,0,0"
                Content="Next"
                Click="next"
                Foreground="Navy"
                Background="CornflowerBlue"
                >
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="25" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            </Button>

        </Grid>

        <!-- 
            USERNAME GRID
            This grid is for prompting the user for username.
            It contains a logo for AI, a textbox for users to enter their name,
            and a submit button to save the username.
            Hidden .
        -->
        <Grid x:Name="username_grid" Visibility="Hidden"
              Background="LightBlue"
              >


            <!-- Logo -->
            <Image 
                Source="/logo.jpg" 
                Height="200"
                Width="300"
                Margin="0,0,0,200"
                   />
            <!-- Hint message-->
            <TextBlock
                Text="Enter username"
                Height="20"
                Width="270"
                TextAlignment="Justify"
                Margin="0,30,0,0"
                FontFamily="Arial Rounded MT Bold"
                />
            
            <!-- Enter/Prompt username-->
            <TextBox
                Height="40"
                Width="270"
                TextAlignment="Center"
                Margin="0,100,0,0"
                FontFamily="Arial Rounded MT Bold"
                x:Name="usernames_input"
                />


            <!-- error message-->
            <TextBlock
         Text="please enter username to continue..."
         Height="20"
         Width="270"
         TextAlignment="Justify"
         Margin="0,180,0,0"
         Foreground="Navy"
         FontFamily="Arial Rounded MT Bold"
         />

            <!-- button to submit name-->
       <Button 
        Height="40"
        Width="150"
        Margin="0,250,0,0"
        Content="submit username"
        Click="submit_name"
        Background="CornflowerBlue"
        Foreground="Navy"        
        >
        <Button.Template>
            <ControlTemplate TargetType="Button">
                   <Border CornerRadius="25" Background="{TemplateBinding Background}">
                         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
            </ControlTemplate>
        </Button.Template>
     </Button>

        </Grid>

        <!-- 
            CHAT GRID
            This grid handles all messaging and conversation-related features of the application.
            It contains a ListView to display chat messages, a textbox for typing questions,
            and a submit button to send the question to the chat.
            Starting in a hidden state.
        -->
        <Grid x:Name="chat_grid" Visibility="Hidden"
              Background="LightGray"
              >


            <!-- List view to show messages show messages-->
            <ListView  
                x:Name="chats" 
                Height="300"
                Margin="0,0,0,120"
                Background="LightBlue"
                />
            
            
            <!-- TextBox to prompt questions-->
            <TextBox
                x:Name="question"
                Height="50"
                Width="600"
                Margin="0,300,150,0"
                />

            <!-- button to submit -->
            <Button
                Height="50"
                Width="100"
                Margin="490,300,0,0"
                Content="Send"
                Click="send"
                Background="CornflowerBlue"
                Foreground="Navy"
                >
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="25" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            </Button>

        </Grid>

    </Grid>
</Window>